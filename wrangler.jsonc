// Configuración de Cloudflare: publica la carpeta dist/ como sitio estático.
// "single-page-application" hace que cualquier dirección abra la app,
// para que funcionen los links internos (/perfil, /clips, etc.).
{
  "name": "haxmatch",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
