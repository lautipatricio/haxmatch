// Configuración de Cloudflare.
// - La web son los archivos de dist/. "single-page-application" hace que
//   cualquier dirección abra la app, para que funcionen los links internos
//   (/perfil, /clips, etc.).
// - worker/index.js atiende solo lo que empieza con /api/ (hoy, mandar las
//   notificaciones, TikTok y Kick). El resto se sirve directo desde dist/.
// - Las claves de los avisos (VAPID_PUBLICA, VAPID_PRIVADA, PUSH_SECRETO) se
//   cargan en el panel de Cloudflare como "Secret". No van en este archivo.
{
  "name": "haxmatch",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Lo que se cargue a mano en el panel no se borra al publicar.
  "keep_vars": true,
  // La dirección propia (comprada en Cloudflare). La de workers.dev sigue andando.
  "routes": [
    { "pattern": "haxmatch.com", "custom_domain": true },
    { "pattern": "www.haxmatch.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // El worker mira cada página (no los archivos de /assets/) para mandar
    // www.haxmatch.com a haxmatch.com y, cuando se active la mudanza, la dirección vieja también.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  // Cada minuto se le pregunta a Kick qué jugadores están en vivo (worker/kick.js).
  "triggers": { "crons": ["* * * * *"] },
  // Datos públicos del proyecto de Supabase (los mismos de .env.production).
  "vars": {
    "SUPABASE_URL": "https://kinckqzqgbnplchyrvhj.supabase.co",
    "SUPABASE_KEY": "sb_publishable_RDSaEKcPGpviQsKr0ks2-w_j5HCHyTW",
    // Dirección principal. Con MUDAR_DIRECCION en "si", la de workers.dev manda todo para acá.
    "DIRECCION": "https://haxmatch.com",
    "MUDAR_DIRECCION": "si",
    // La dirección que TikTok tiene registrada para volver de la vinculación (worker/tiktok.js).
    "TIKTOK_VUELTA": "https://haxmatch.lauti.workers.dev"
  }
}
